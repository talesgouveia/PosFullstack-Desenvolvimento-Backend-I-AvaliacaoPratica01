<h1 class="mb-3">Pesquisa de Oficinas</h1>

{{#if erroFormulario}}
  <div class="alert alert-danger" role="alert">{{erroFormulario}}</div>
{{/if}}

<form method="post" action="/pesquisa">
  <div class="mb-3">
    <label class="form-label" for="titulo">Título da oficina</label>
    <input class="form-control" id="titulo" name="titulo" type="text" value="{{termo}}" required>
  </div>
  <button class="btn btn-primary" type="submit">Pesquisar</button>
</form>

{{#if pesquisaRealizada}}
  {{#if encontrouOficinas}}
    <ul class="mt-3">
      {{#each oficinas}}
        <li><a href="/oficina/consulta/{{id}}">{{titulo}}</a></li>
      {{/each}}
    </ul>
  {{else}}
    <p class="mt-3">Nenhuma oficina encontrada.</p>
  {{/if}}
{{else}}
  <p class="mt-3">Digite um termo para pesquisar pelo título da oficina.</p>
{{/if}}
